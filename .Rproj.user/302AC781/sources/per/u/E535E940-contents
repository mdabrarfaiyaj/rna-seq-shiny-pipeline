# ============================================================
# RNA-Seq Differential Expression Pipeline — VERSION 2
# ============================================================
# Dataset    : GSE157234 — Shemer et al., Immunity 2020
# Comparison : IL10R-Mutant vs Control Microglia (48h post-LPS)
# Author     : Md. Abrar Faiyaj
# GitHub     : https://github.com/mdabrarfaiyaj/rna-seq-shiny-pipeline
#
# BIOLOGICAL QUESTION:
#   What genes are differentially expressed in microglia that
#   cannot sense IL-10 (IL10R-deficient / Mutant) compared to
#   microglia with intact IL-10 signalling (Control), at 48h
#   after peripheral LPS challenge — the point of peak
#   hyperactivation described in Figure 3E of the paper?
#
# V2 IMPROVEMENT OVER V1:
#   V1 used UTAP-normalized counts from GEO (the only file
#   available at that time). UTAP outputs DESeq2's own size-
#   factor normalized values — feeding these back into a new
#   DESeq2 run caused double-normalization, explaining the
#   DEG count difference from the paper (669 up/894 down vs
#   paper's 954 up/693 down).
#
#   V2 uses genuine raw integer counts generated from:
#     SRA FASTQs → HISAT2 alignment → featureCounts (Galaxy)
#   These are true pre-normalization counts. DESeq2 now
#   performs normalization exactly once, as intended.
#
# ANNOTATION NOTE:
#   The original paper used UTAP with Gencode vM10 (mm10)
#   annotation, counting reads in a 3'UTR window (1000bp
#   upstream of 3'end + 100bp downstream). V2 uses Galaxy
#   featureCounts with NCBI RefSeq built-in mm10 annotation
#   counting all exons. Gene IDs are Entrez numeric IDs
#   mapped to gene symbols using org.Mm.eg.db. Minor count
#   differences due to annotation choice are expected and
#   documented here.
#
# SAMPLE MAPPING (confirmed from Galaxy history — Mutant first):
#   Galaxy 196 → SRR12564699 → Mutant
#   Galaxy 190 → SRR12564698 → Mutant
#   Galaxy 184 → SRR12564697 → Mutant
#   Galaxy 178 → SRR12564671 → Control
#   Galaxy 172 → SRR12564670 → Control
#   Galaxy 166 → SRR12564669 → Control
#   Galaxy 160 → SRR12564668 → Control
#   Galaxy 154 → SRR12564667 → Control
#   Galaxy 148 → SRR12564666 → Control
#
# PIPELINE OVERVIEW:
#   Block 1  → Install required packages
#   Block 2  → Load libraries
#   Block 3  → Create output folders
#   Block 4  → Load Galaxy featureCounts output
#   Block 5  → Rename columns and build metadata
#   Block 6  → Map Entrez IDs to gene symbols
#   Block 7  → Clean count matrix
#   Block 8  → Run DESeq2 differential expression
#   Block 9  → VST transformation for visualisation
#   Block 10 → Volcano plot
#   Block 11 → PCA plot
#   Block 12 → Heatmap (top 50 DEGs)
#   Block 13 → Save reproducibility outputs
# ============================================================


# ============================================================
# BLOCK 1: INSTALL REQUIRED PACKAGES
# ============================================================
# WHY: V2 adds org.Mm.eg.db which was not needed in V1.
# This package maps Entrez Gene IDs (numbers like 100008567)
# to recognisable gene symbols (like Tnf, Sall1, P2ry12).
# Without this mapping, plots show numbers instead of names.
# ============================================================
cat("\n--- Block 1: Checking and installing packages ---\n")

if (!requireNamespace("BiocManager", quietly = TRUE))
  install.packages("BiocManager")

cran_pkgs <- c("ggplot2", "ggrepel", "pheatmap", "dplyr",
               "RColorBrewer", "scales", "viridis")
for (pkg in cran_pkgs) {
  if (!requireNamespace(pkg, quietly = TRUE)) install.packages(pkg)
}

bioc_pkgs <- c("DESeq2", "org.Mm.eg.db", "AnnotationDbi","apeglm")
for (pkg in bioc_pkgs) {
  if (!requireNamespace(pkg, quietly = TRUE))
    BiocManager::install(pkg, ask = FALSE)
}
cat("✓ All packages ready\n")


# ============================================================
# BLOCK 2: LOAD LIBRARIES
# ============================================================
# WHY: Loading makes package functions available in this session.
# org.Mm.eg.db is the mouse gene annotation database from
# Bioconductor — it maps between Entrez IDs, gene symbols,
# Ensembl IDs, and other identifier types.
# ============================================================
cat("\n--- Block 2: Loading libraries ---\n")

library(DESeq2);        library(ggplot2);      library(ggrepel)
library(pheatmap);      library(dplyr);        library(RColorBrewer)
library(org.Mm.eg.db);  library(AnnotationDbi); library(scales)
library(viridis)

cat("✓ Libraries loaded\n")


# ============================================================
# BLOCK 3: CREATE OUTPUT FOLDERS
# ============================================================
# WHY: R cannot save to folders that do not exist. This block
# creates all required directories before any output is
# attempted. The v2/ prefix keeps V2 outputs separate from
# V1 for clean comparison and version tracking.
# ============================================================
cat("\n--- Block 3: Creating output folders ---\n")

for (f in c("data/v2", "results/v2", "plots/v2")) {
  if (!dir.exists(f)) dir.create(f, recursive = TRUE)
}
cat("✓ Output folders ready\n")


# ============================================================
# BLOCK 4: LOAD GALAXY FEATURE COUNTS OUTPUT
# ============================================================
# WHY: The Galaxy featureCounts column join produces a tabular
# file with one column per sample. The first column (Geneid)
# contains Entrez numeric gene IDs. Each remaining column
# contains raw integer read counts for one sample.
#
# KEY DIFFERENCE FROM V1:
#   V1: read.table on UTAP normalized counts → had to round
#   V2: read.table on raw integer counts → no rounding needed
#       Values are already true integers from featureCounts
#
# The file path below assumes the Galaxy tabular file has been
# placed in your data/ folder. Update the path if needed.
# ============================================================
cat("\n--- Block 4: Loading Galaxy featureCounts output ---\n")

# ── ACTION REQUIRED ────────────────────────────────────────────
# Before running, rename your Galaxy tabular file to something
# clean and copy it into your data/ folder.
#
# In terminal/file explorer, rename the Galaxy file to:
#   raw_counts_featurecounts.tabular
#
# Then run this in terminal to copy it:
#   cp "Galaxy363-_Column_join_...tabular" data/raw_counts_featurecounts.tabular
#
# If you prefer to keep the original filename, update the path
# below to match exactly.
# ──────────────────────────────────────────────────────────────
galaxy_file <- "data/raw_counts_featurecounts.tabular"

if (!file.exists(galaxy_file)) {
  stop(paste(
    "\nGalaxy tabular file not found.",
    "\nExpected location:", file.path(getwd(), galaxy_file),
    "\n\nTo fix:",
    "\n  1. Open this project via its .Rproj file in RStudio",
    "\n  2. Copy your Galaxy tabular file into the data/ folder",
    "\n  3. Rename it to: raw_counts_featurecounts.tabular",
    "\n\nCurrent working directory:", getwd(),
    "\nMake sure you opened the project .Rproj file — not the script directly."
  ))
}

galaxy_raw <- read.table(
  galaxy_file,
  header    = TRUE,
  sep       = "\t",
  row.names = 1,       # Geneid column becomes rownames
  check.names = FALSE
)

cat("Raw dimensions:", nrow(galaxy_raw), "genes x",
    ncol(galaxy_raw), "samples\n")

# Confirm column names from Galaxy
cat("\nGalaxy column names as loaded:\n")
for (i in seq_along(colnames(galaxy_raw))) {
  cat(sprintf("  Column %d: %s\n", i, colnames(galaxy_raw)[i]))
}

# Confirm values are integers (raw counts sanity check)
cat("\nValue range validation (expect whole numbers in hundreds-thousands):\n")
cat("  Min    :", min(galaxy_raw, na.rm = TRUE), "\n")
cat("  Max    :", max(galaxy_raw, na.rm = TRUE), "\n")
cat("  Median non-zero:",
    median(unlist(galaxy_raw)[unlist(galaxy_raw) > 0], na.rm = TRUE), "\n")
cat("✓ Galaxy counts loaded\n")


# ============================================================
# BLOCK 5: RENAME COLUMNS AND BUILD METADATA (CORRECTED)
# ============================================================
# WHY: Galaxy produces generic column names like
# "featureCounts on dataset 196: Counts" which are meaningless
# for biology. We rename them to readable condition labels.
#
# CRITICAL — COLUMN ORDER:
#   The Galaxy tabular file lists samples in DESCENDING dataset
#   number order (196 first, 148 last) — the opposite of what
#   you might expect. This was confirmed from the actual file
#   and Galaxy history (Galaxy_Output.pdf).
#
#   Column 1 → Galaxy 196 → SRR12564699 → Mutant
#   Column 2 → Galaxy 190 → SRR12564698 → Mutant
#   Column 3 → Galaxy 184 → SRR12564697 → Mutant
#   Column 4 → Galaxy 178 → SRR12564671 → Control
#   Column 5 → Galaxy 172 → SRR12564670 → Control
#   Column 6 → Galaxy 166 → SRR12564669 → Control
#   Column 7 → Galaxy 160 → SRR12564668 → Control
#   Column 8 → Galaxy 154 → SRR12564667 → Control
#   Column 9 → Galaxy 148 → SRR12564666 → Control
#
#   Getting this order wrong would silently flip all fold
#   changes — Mutant would become Control and vice versa.
#   This is the most dangerous class of bug in RNA-seq:
#   the code runs without errors but biology is inverted.
#
# WHY condition IS A FACTOR WITH LEVELS c("Control","Mutant"):
#   DESeq2 uses Control as the reference (denominator).
#   Positive LFC = higher in Mutant = upregulated in mutant.
# ============================================================
cat("\n--- Block 5: Renaming columns and building metadata ---\n")

# Safety check: file must have exactly 9 count columns
if (ncol(galaxy_raw) != 9) {
  stop(paste("Expected 9 columns, found:", ncol(galaxy_raw),
             "\nCheck Galaxy file and sample mapping."))
}

# Correct order: Mutant first (Galaxy 196,190,184), Control second
readable_names <- c(
  "Mutant_1",  "Mutant_2",  "Mutant_3",    # Galaxy 196, 190, 184
  "Control_1", "Control_2", "Control_3",   # Galaxy 178, 172, 166
  "Control_4", "Control_5", "Control_6"    # Galaxy 160, 154, 148
)

srr_names <- c(
  "SRR12564699", "SRR12564698", "SRR12564697",  # Mutant
  "SRR12564671", "SRR12564670", "SRR12564669",  # Control
  "SRR12564668", "SRR12564667", "SRR12564666"   # Control
)

# Rename columns in the count matrix
colnames(galaxy_raw) <- readable_names

# Build metadata table — row order must match column order above
metadata_v2 <- data.frame(
  sample_id  = readable_names,
  srr        = srr_names,
  condition  = factor(
    c(rep("Mutant", 3), rep("Control", 6)),
    levels = c("Control", "Mutant")   # Control is reference level
  ),
  timepoint  = "48h",
  row.names  = readable_names,
  stringsAsFactors = FALSE
)

cat("\nSample metadata (correct order from Galaxy_Output.pdf):\n")
print(metadata_v2[, c("sample_id", "srr", "condition")])
cat("\nCondition counts:\n")
print(table(metadata_v2$condition))
cat("✓ Metadata ready — column order verified\n")


# ============================================================
# BLOCK 6: MAP ENTREZ GENE IDs TO GENE SYMBOLS
# ============================================================
# WHY: featureCounts with NCBI RefSeq built-in annotation
# outputs Entrez Gene IDs (e.g. 11287, 21926) rather than
# gene symbols (e.g. Parp1, Tnf). Entrez IDs are numeric
# identifiers in NCBI's database — they are stable but not
# human readable. We need gene symbols for biological
# interpretation and for matching to the paper's gene names.
#
# HOW mapIds() WORKS:
#   org.Mm.eg.db — Mus musculus (mouse) genome annotation db
#   keys       = Entrez IDs (rownames of count matrix)
#   column     = "SYMBOL" (what we want to retrieve)
#   keytype    = "ENTREZID" (what we are providing)
#   multiVals  = "first" (if one Entrez maps to multiple
#                symbols, take the first — rare but possible)
#
# WHY KEEP ENTREZ AS FALLBACK:
#   Some Entrez IDs have no gene symbol (e.g. predicted genes,
#   novel transcripts). We use make.unique() to handle any
#   duplicate symbols — rare but important to handle cleanly.
# ============================================================
cat("\n--- Block 6: Mapping Entrez IDs to gene symbols ---\n")

entrez_ids <- rownames(galaxy_raw)

gene_symbols <- mapIds(
  org.Mm.eg.db,
  keys     = entrez_ids,
  column   = "SYMBOL",
  keytype  = "ENTREZID",
  multiVals = "first"
)

# Count mapping success
n_mapped   <- sum(!is.na(gene_symbols))
n_unmapped <- sum(is.na(gene_symbols))
cat("Entrez IDs mapped to symbols:", n_mapped, "\n")
cat("Entrez IDs with no symbol   :", n_unmapped, "(will keep Entrez ID)\n")

# Use symbol where available, fall back to Entrez ID
final_names <- ifelse(
  is.na(gene_symbols),
  entrez_ids,           # fallback: keep numeric Entrez ID
  gene_symbols          # preferred: human readable symbol
)

# Handle duplicate symbols with make.unique()
final_names <- make.unique(final_names)

# Apply to count matrix
count_matrix_v2 <- as.matrix(galaxy_raw)
rownames(count_matrix_v2) <- final_names

# Confirm a few key biological markers mapped correctly
key_genes <- c("Tnf", "Ccl5", "Il6", "P2ry12", "Sall1", "Tmem119", "Il10ra")
cat("\nKey biological markers found in matrix:\n")
for (g in key_genes) {
  found <- g %in% rownames(count_matrix_v2)
  cat(sprintf("  %-12s : %s\n", g, ifelse(found, "✓ FOUND", "✗ MISSING")))
}
cat("✓ Gene symbol mapping complete\n")


# ============================================================
# BLOCK 7: CLEAN COUNT MATRIX
# ============================================================
# WHY: Before DESeq2 we must ensure:
#   1. Values are stored as integers (required by DESeq2 model)
#   2. No negative values (counts cannot be negative)
#   3. No NA values (DESeq2 errors on NA rows)
#   4. Sample order in count matrix matches metadata rows
#      (DESeq2 uses positional matching — order must be exact)
#
# NOTE ON ROUNDING IN V2:
#   featureCounts produces true integers. storage.mode coercion
#   is a safety step only — values should already be integers.
#   Unlike V1 where rounding was a methodological compromise,
#   in V2 this is just defensive type enforcement.
# ============================================================
cat("\n--- Block 7: Cleaning count matrix ---\n")

# Enforce integer storage (defensive — values already integers)
storage.mode(count_matrix_v2) <- "integer"

# Remove negative values (should be none — counts are positive)
n_negative <- sum(count_matrix_v2 < 0, na.rm = TRUE)
if (n_negative > 0) {
  cat("⚠ Negative values found and zeroed:", n_negative, "\n")
  count_matrix_v2[count_matrix_v2 < 0] <- 0L
}

# Remove rows with NA values
na_rows <- rowSums(is.na(count_matrix_v2)) > 0
cat("Rows with NA values removed:", sum(na_rows), "\n")
count_matrix_v2 <- count_matrix_v2[!na_rows, ]

# Align sample order: count matrix columns must match metadata rows
shared_samples      <- intersect(colnames(count_matrix_v2),
                                 rownames(metadata_v2))
count_matrix_v2     <- count_matrix_v2[, shared_samples, drop = FALSE]
metadata_v2         <- metadata_v2[shared_samples, , drop = FALSE]

cat("Final count matrix:", nrow(count_matrix_v2), "genes x",
    ncol(count_matrix_v2), "samples\n")
cat("Metadata rows     :", nrow(metadata_v2), "\n")
cat("Order match check :", all(colnames(count_matrix_v2) ==
                                 rownames(metadata_v2)), "✓\n")

# Save clean data for reproducibility and Shiny app
write.csv(count_matrix_v2, "data/v2/count_matrix_raw_v2.csv")
write.csv(metadata_v2,     "data/v2/metadata_v2.csv")
cat("✓ Clean raw count matrix saved to data/v2/\n")


# ============================================================
# BLOCK 8: RUN DESeq2 DIFFERENTIAL EXPRESSION
# ============================================================
# WHY THIS IS THE KEY IMPROVEMENT OVER V1:
#   V1 — normalized counts → rounded → DESeq2 (double-normalized)
#   V2 — true raw integers → DESeq2 (normalized exactly once)
#
#   DESeq2 now performs normalization internally as designed:
#   Raw counts → size factor estimation → dispersion estimation
#   → negative binomial GLM → Wald test → BH correction
#
# FILTER THRESHOLD:
#   rowSums(counts >= 10) >= 2 removes genes with fewer than
#   10 counts in at least 2 samples. Lowly expressed genes
#   have high noise. This threshold is slightly relaxed vs
#   the paper's "minimum 5 reads in at least one sample"
#   to be slightly more conservative. Change if desired.
#
# DESeq2 PARAMETERS:
#   We do NOT set betaPrior=TRUE. That parameter was deprecated
#   in DESeq2 v1.16 (2017). The paper used betaPrior=TRUE via
#   their 2020 UTAP pipeline. Modern DESeq2 uses apeglm shrinkage
#   instead via lfcShrink() — this is the correct current approach.
#   This is one documented reason our DEG numbers will differ
#   slightly from the paper.
#
# set.seed(123): ensures reproducible results across runs for
# any stochastic steps in DESeq2's numerical optimisation.
# ============================================================
cat("\n--- Block 8: Running DESeq2 on true raw counts ---\n")
cat("Input type: TRUE RAW COUNTS from featureCounts (Galaxy)\n")
cat("Control samples:", sum(metadata_v2$condition == "Control"), "\n")
cat("Mutant  samples:", sum(metadata_v2$condition == "Mutant"), "\n\n")

# Build DESeqDataSet from raw count matrix
dds <- DESeqDataSetFromMatrix(
  countData = count_matrix_v2,
  colData   = metadata_v2,
  design    = ~ condition
)

# Pre-filter low-count genes
keep <- rowSums(counts(dds) >= 10) >= 2
dds  <- dds[keep, ]
cat("Genes after low-count filtering:", nrow(dds), "\n")

# Run DESeq2 — reproducible with set.seed
set.seed(123)
dds <- DESeq(dds)
cat("✓ DESeq2 complete\n")

# Extract results: Mutant vs Control
res <- results(
  dds,
  contrast  = c("condition", "Mutant", "Control"),
  alpha     = 0.05
)
cat("\nDESeq2 results summary:\n")
summary(res)

# Apply LFC shrinkage (modern replacement for betaPrior=TRUE)
# apeglm shrinkage reduces noise in fold change estimates for
# lowly expressed genes — improves volcano plot appearance
res_shrunk <- lfcShrink(
  dds,
  coef = "condition_Mutant_vs_Control",
  type = "apeglm"
)
cat("\nLFC shrinkage (apeglm) applied — improves fold change estimates\n")

# Build annotated results dataframe
res_df <- as.data.frame(res_shrunk)
res_df$gene <- rownames(res_df)
res_df <- res_df %>%
  mutate(
    significance = case_when(
      padj < 0.05 & log2FoldChange >  1 ~ "Up in Mutant",
      padj < 0.05 & log2FoldChange < -1 ~ "Down in Mutant",
      TRUE                               ~ "Not significant"
    )
  ) %>%
  arrange(padj)

# Count DEGs
n_up   <- sum(res_df$significance == "Up in Mutant",   na.rm = TRUE)
n_down <- sum(res_df$significance == "Down in Mutant",  na.rm = TRUE)

cat("\n==========================================\n")
cat("  V2 DEG RESULTS (TRUE RAW COUNTS)\n")
cat("==========================================\n")
cat("Upregulated in Mutant  :", n_up, "\n")
cat("Downregulated in Mutant:", n_down, "\n")
cat("Total DEGs             :", n_up + n_down, "\n")
cat("\nPaper reported (Figure 3E, 48h):\n")
cat("  Upregulated  : 954\n")
cat("  Downregulated: 693\n")
cat("  Total        : 1647\n")
cat("\nNOTE: Differences expected due to:\n")
cat("  1. Annotation: RefSeq (V2) vs Gencode vM10 (paper)\n")
cat("  2. Counting: all exons (V2) vs 3'UTR window (paper/UTAP)\n")
cat("  3. betaPrior: FALSE/apeglm (V2) vs TRUE (paper)\n")
cat("  Biological conclusions should be consistent.\n")
cat("==========================================\n")

# Save DESeq2 results to CSV
write.csv(res_df, "results/v2/DESeq2_results_v2_Mutant_vs_Control.csv",
          row.names = FALSE)

# Save top 100 up and down regulated genes
top_up <- res_df %>%
  filter(significance == "Up in Mutant") %>%
  arrange(padj) %>%
  head(100)

top_down <- res_df %>%
  filter(significance == "Down in Mutant") %>%
  arrange(padj) %>%
  head(100)

write.csv(top_up,   "results/v2/top100_upregulated_v2.csv",   row.names = FALSE)
write.csv(top_down, "results/v2/top100_downregulated_v2.csv",  row.names = FALSE)

cat("\nTop 10 upregulated genes (Mutant vs Control):\n")
print(top_up[1:min(10, nrow(top_up)),
             c("gene", "log2FoldChange", "padj")])

cat("\nTop 10 downregulated genes (Mutant vs Control):\n")
print(top_down[1:min(10, nrow(top_down)),
               c("gene", "log2FoldChange", "padj")])
cat("✓ DESeq2 results saved\n")


# ============================================================
# BLOCK 9: VST TRANSFORMATION
# ============================================================
# WHY: Raw counts and normalized counts have high variance for
# highly expressed genes — this makes PCA and heatmaps hard
# to interpret visually. Variance Stabilising Transformation
# (VST) compresses the dynamic range so that low and high
# expressed genes contribute equally to clustering patterns.
#
# VST is for VISUALISATION ONLY — DESeq2 uses raw counts for
# the actual statistical test internally. These VST values
# are never fed back into DESeq2 (unlike V1's problem).
#
# blind = FALSE: uses the design formula when estimating
# dispersion — more accurate for samples with known groups.
# ============================================================
cat("\n--- Block 9: VST transformation for visualisation ---\n")

vsd <- vst(dds, blind = FALSE)
cat("✓ VST transformation complete\n")


# ============================================================
# BLOCK 10: VOLCANO PLOT
# ============================================================
# WHY: A volcano plot shows all genes simultaneously — the
# x-axis is log2 fold change (effect size) and y-axis is
# -log10 adjusted p-value (statistical confidence). This
# allows quick identification of genes that are both
# statistically significant AND biologically meaningful.
#
# LABELLING STRATEGY:
#   We label known key microglia markers from the paper
#   (Tnf, Ccl5, P2ry12, Sall1, Tmem119) plus the top 15
#   DEGs by adjusted p-value. ggrepel prevents label overlap.
# ============================================================
cat("\n--- Block 10: Volcano plot ---\n")

# Key genes to always label (from paper Figure 3D)
paper_genes <- c("Tnf", "Ccl5", "Il6", "Il12b", "Il1b",
                 "P2ry12", "Sall1", "Tmem119", "Mertk",
                 "Tlr4", "Il10ra", "Aif1")

# Top 15 significant genes by padj
top_label_genes <- res_df %>%
  filter(!is.na(padj), significance != "Not significant") %>%
  arrange(padj) %>%
  head(15) %>%
  pull(gene)

# Combine label sets
label_genes <- unique(c(paper_genes, top_label_genes))

# Prepare plot data
plot_data <- res_df %>%
  filter(!is.na(padj), !is.na(log2FoldChange)) %>%
  mutate(
    neg_log10_padj = -log10(padj),
    label = ifelse(gene %in% label_genes, gene, NA)
  )

volcano_v2 <- ggplot(
  plot_data,
  aes(x = log2FoldChange, y = neg_log10_padj,
      colour = significance, label = label)
) +
  geom_point(alpha = 0.6, size = 1.2) +
  geom_text_repel(
    na.rm         = TRUE,
    size          = 3,
    max.overlaps  = 20,
    colour        = "black",
    fontface      = "italic",
    box.padding   = 0.4,
    segment.color = "grey60",
    segment.size  = 0.3
  ) +
  geom_hline(yintercept = -log10(0.05),
             linetype = "dashed", colour = "grey40") +
  geom_vline(xintercept = c(-1, 1),
             linetype = "dashed", colour = "grey40") +
  scale_colour_manual(values = c(
    "Up in Mutant"    = "#d73027",
    "Down in Mutant"  = "#4575b4",
    "Not significant" = "grey70"
  )) +
  labs(
    title    = "Volcano Plot: IL10R-Mutant vs Control Microglia",
    subtitle = paste0("48h post-LPS | GSE157234 | V2 (True Raw Counts) | ",
                      n_up, " up / ", n_down, " down"),
    x        = "log\u2082 Fold Change (Mutant / Control)",
    y        = "-log\u2081\u2080 Adjusted p-value",
    colour   = NULL,
    caption  = "padj < 0.05 & |LFC| > 1 | apeglm shrinkage applied"
  ) +
  theme_bw(base_size = 12) +
  theme(
    plot.title    = element_text(face = "bold", size = 13),
    plot.subtitle = element_text(size = 10, colour = "grey40"),
    legend.position = "top",
    panel.grid.minor = element_blank()
  )

ggsave("plots/v2/volcano_plot_v2.png", volcano_v2,
       width = 10, height = 8, dpi = 300)
ggsave("plots/v2/volcano_plot_v2.pdf", volcano_v2,
       width = 10, height = 8)
cat("✓ Volcano plot saved (PNG + PDF)\n")


# ============================================================
# BLOCK 11: PCA PLOT
# ============================================================
# WHY: Principal Component Analysis reduces thousands of gene
# dimensions into two axes (PC1, PC2) that capture maximum
# variance. In a successful experiment, samples from the same
# condition cluster together. The paper's Figure 3B shows
# clear Mutant/Control separation at 48h — our V2 PCA should
# replicate this separation pattern.
#
# If Control and Mutant samples do NOT separate in V2 PCA,
# it would indicate a problem with sample assignment (check
# the Galaxy column order in Block 5 carefully).
# ============================================================
cat("\n--- Block 11: PCA plot ---\n")

pca_data <- plotPCA(vsd, intgroup = "condition", returnData = TRUE)
pca_data$PC1 <- -pca_data$PC1 
pct_var  <- round(100 * attr(pca_data, "percentVar"), 1)

pca_v2 <- ggplot(pca_data,
