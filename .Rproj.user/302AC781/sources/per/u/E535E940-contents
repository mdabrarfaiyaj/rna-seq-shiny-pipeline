# ============================================================
# BLOCK 12: HEATMAP (TOP 50 DEGs)
# ============================================================
# WHY: A heatmap shows expression levels of the most
# differentially expressed genes across all samples. It
# visually confirms the direction and consistency of changes.
# In the paper, Figure 3C shows clear red (up) and blue (down)
# blocks separating Mutant from Control — our heatmap should
# reproduce this pattern if the analysis is correct.
#
# TOP 50 SELECTION: Genes ranked by adjusted p-value.
# Z-SCORING: Each gene is scaled across samples so colours
# reflect relative change (red = above mean, blue = below mean).
# This removes absolute expression level differences and
# focuses attention on the pattern of change.
# ============================================================
cat("\n--- Block 12: Heatmap (top 50 DEGs) ---\n")

# Select top 50 DEGs by padj
top50_genes <- res_df %>%
  filter(significance != "Not significant", !is.na(padj)) %>%
  arrange(padj) %>%
  head(50) %>%
  pull(gene)

# Check all top50 genes exist in VST matrix
top50_genes <- top50_genes[top50_genes %in% rownames(vsd)]
cat("Top 50 DEGs found in VST matrix:", length(top50_genes), "\n")

# Extract VST values for top50
heatmap_mat <- assay(vsd)[top50_genes, ]

# Z-score each gene (row) across samples
heatmap_scaled <- t(scale(t(heatmap_mat)))

# Annotation bar for column conditions
col_annotation <- data.frame(
  Condition = metadata_v2$condition,
  row.names = colnames(heatmap_mat)
)

ann_colours <- list(
  Condition = c("Control" = "#4575b4", "Mutant" = "#d73027")
)

# Save heatmap
png("plots/v2/heatmap_top50_DEGs_v2.png",
    width = 1800, height = 2200, res = 200)
pheatmap(
  heatmap_scaled,
  annotation_col    = col_annotation,
  annotation_colors = ann_colours,
  color             = colorRampPalette(rev(
    brewer.pal(11, "RdBu")))(100),
  breaks            = seq(-2, 2, length.out = 101),
  cluster_rows      = TRUE,
  cluster_cols      = TRUE,
  show_rownames     = TRUE,
  show_colnames     = TRUE,
  fontsize_row      = 7,
  fontsize_col      = 9,
  main              = paste0(
    "Top 50 DEGs: IL10R-Mutant vs Control\n",
    "GSE157234 | V2 True Raw Counts | Shemer et al., 2020"
  )
)
dev.off()

pdf("plots/v2/heatmap_top50_DEGs_v2.pdf",
    width = 9, height = 11)
pheatmap(
  heatmap_scaled,
  annotation_col    = col_annotation,
  annotation_colors = ann_colours,
  color             = colorRampPalette(rev(
    brewer.pal(11, "RdBu")))(100),
  breaks            = seq(-2, 2, length.out = 101),
